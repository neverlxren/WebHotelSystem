@model List<WebHotelSystem.Models.Apartment>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Apartment List";
}

<link rel="stylesheet"
      href="~/css/apartmentStyle.css"
      asp-append-version="true" />

<main class="page-shell">

    <header class="topbar">

        <a class="brand" href="#">
            <span class="brand-mark">A</span>
            <span>ApartmentsDB</span>
        </a>

        <div class="topbar-actions">

            <button class="icon-button" type="button">
                ⌁
                <span class="notification-dot"></span>
            </button>

            <button class="profile" type="button">
                <span>АД</span>
            </button>

        </div>

    </header>


    <section class="hero">

        <div>

            <p class="eyebrow">
                ОБЗОР ОТЕЛЯ
            </p>

            <h1>
                Апартаменты
            </h1>

            <p class="subtitle">
                Статус номеров на сегодня, @DateTime.Now.Date
            </p>

        </div>

        <button class="add-button" type="button">
            <span>+</span>
            Добавить номер
        </button>

    </section>


    <section class="summary">

        <article>
            <span class="status-dot available"></span>

            <div>
                <strong id="available-count">0</strong>
                <span>Свободно</span>
            </div>
        </article>


        <article>
            <span class="status-dot cleaning"></span>

            <div>
                <strong id="cleaning-count">0</strong>
                <span>Уборка</span>
            </div>
        </article>


        <article>
            <span class="status-dot occupied"></span>

            <div>
                <strong id="occupied-count">0</strong>
                <span>Занято</span>
            </div>
        </article>

    </section>


    <section class="apartments-panel">

        <div class="panel-heading">

            <div>

                <h2>
                    Номера
                </h2>

                <p>
                    Нажмите на карточку, чтобы открыть бронирование
                </p>

            </div>


            <button class="filter-button" type="button">

                ⌄

                <span>
                    Все этажи
                </span>

            </button>

        </div>


        <div class="apartment-grid">

            @foreach (var room in Model)
            {
                <a asp-controller="Apartment"
                   asp-action="ApartmentDetails"
                   asp-route-id="@room.Id"
                   class="room-card @(room.IsReady ? "available" : "not-ready")">

                    <div class="room-number">
                        @room.AppNumber
                    </div>

                    <div class="room-status">

                        <span class="status-dot"></span>

                        @if (room.IsReady)
                        {
                            <span>
                                Свободен
                            </span>
                        }
                        else
                        {
                            <span>
                                Не готов
                            </span>
                        }

                    </div>

                </a>
            }

        </div>

    </section>

</main>

