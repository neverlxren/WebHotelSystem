@model WebHotelSystem.Models.Client

@{
    ViewBag.Title = "title";
    Layout = "_Layout";
}

<h1>@Model.ClientName</h1>

<h2>@Html.DisplayNameFor(client => client.Email)</h2>

<form asp-action="EditClient"  method="post">
    
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="Id">

    <input asp-for="ClientName" type="text" value="@Model.ClientName" placeholder="Enter your name">
    <span asp-validation-for="ClientName" class="text-danger"></span> <br>

    <input asp-for="PhoneNumber" type="text" value="@Model.PhoneNumber" placeholder="Enter your phone number"></input>
    <span asp-validation-for="PhoneNumber" class="text-danger"></span> <br>

    <input asp-for="Email" type="text" value="@Model.Email" placeholder="Enter your email"></input>
    <span asp-validation-for="Email" class="text-danger"></span>

    <input asp-for="GuestCount" value="@Model.GuestCount" type="text">

    <button>Send</button>

</form>
