@model WebHotelSystem.ViewModels.HotelWifiSettingsViewModel

using Microsoft.AspNetCore.Mvc.Rendering;
using Microsoft.EntityFrameworkCore;



<link rel="stylesheet" href="/css/apartmentdetails.css" />

@{
    ViewData["Title"] = "Добавить Wi-Fi сеть";
    Layout = "_Layout";
}

<main class="apartment-edit-page">

    <a asp-action="WifiSettings" class="back-link">
        ← Назад к настройкам Wi-Fi
    </a>

    <section class="apartment-edit-heading">
        <div>
            <p class="page-label">СЕТЬ ОТЕЛЯ</p>
            <h1>Добавить Wi-Fi сеть</h1>
            <p class="page-description">
                Укажите номер комнаты и данные сети.
            </p>
        </div>
    </section>

    <section class="apartment-edit-layout">

        <form asp-action="Create"
              method="post"
              class="apartment-edit-form">

            <div class="form-title">
                <span class="form-number">01</span>
                <div>
                    <h2>Данные сети</h2>
                    <p>Сеть будет привязана к выбранному номеру</p>
                </div>
            </div>

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="apartment-form-grid">

                <div class="form-field">
                    <label asp-for="AppNumb">Номер комнаты</label>
                    <select asp-for="AppNumb" asp-items="Model.ApartmentOptions">
                        <option value="">Выберите номер</option>
                    </select>
                    <span asp-validation-for="AppNumb" class="text-danger"></span>
                </div>

                <div class="form-field">
                    <label asp-for="WifiName">Название сети</label>
                    <input asp-for="WifiName"
                           placeholder="Например, Hotel-307" />
                    <span asp-validation-for="WifiName" class="text-danger"></span>
                </div>

                <div class="form-field">
                    <label asp-for="WifiPassword">Пароль</label>
                    <input asp-for="WifiPassword"
                           type="password"
                           placeholder="Введите пароль Wi-Fi"
                           autocomplete="new-password" />
                    <span asp-validation-for="WifiPassword" class="text-danger"></span>
                </div>

            </div>

            <div class="form-actions">
                <a asp-action="WifiSettings" class="cancel-button">
                    Отмена
                </a>

                <button type="submit" class="save-button">
                    Добавить сеть
                </button>
            </div>
        </form>

        <aside class="apartment-preview-card">
            <div class="preview-room-icon">Wi-Fi</div>
            <p class="preview-label">НОВАЯ СЕТЬ</p>
            <h2>Настройки доступа</h2>

            <div class="preview-data">
                <div>
                    <span>Номер</span>
                    <strong>@(Model.AppNumb?.ToString() ?? "Не выбран")</strong>
                </div>
                <div>
                    <span>Сеть</span>
                    <strong>@(string.IsNullOrWhiteSpace(Model.WifiName)
                        ? "Не указана"
                        : Model.WifiName)</strong>
                </div>
            </div>
        </aside>

    </section>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}